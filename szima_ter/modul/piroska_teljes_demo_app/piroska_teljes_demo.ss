(define PiroskaSztarTeljes-PiroskaSztarTeljesMondatok (cons "Volt egyszer egy kislany, aki a nagyamajatol egy szep piros sapkat kapott." (cons "Mindenki csak Piroskanak szolitotta." (cons "Egy napon nagyanyja megbetegedett." (cons "Piroska etelt visz neki az erdon at." (cons "Anyja intette, hogy ne terjen le az utrol." (cons "Piroska talalkozott a farkassal az erdoben." (cons "A farkas ravette, hogy viragot szedjen." (cons "A farkas elfutott a hazhoz, felfalta a nagyamat." (cons "A farkas atvette a nagymama helyet." (cons "Piroska eszrevette, hogy valami megvaltozott." (cons "Nagymama, miert ilyen nagy a fuled?" (cons "Hogy jobban halljalak." (cons "Nagymama, miert ilyen nagy a szemed?" (cons "Hogy jobban lassalak." (cons "Nagymama, miert ilyen nagy a szajad?" (cons "Hogy jobban felfalhasalak." (cons "A farkas megette Piroskat, majd elaludt." (cons "A vadasz olloval felvagma a farkas hasat." (cons "Piroska es a nagyany kimaszott." (cons "Sziklakkal pakoltak meg a farkas gyomrat." (cons "A farkas felebredt, a kuthoz ment, es megfulladt." (cons "Piroska megfogadta, hogy szot fogad az anyjanak." '())))))))))))))))))))))))
